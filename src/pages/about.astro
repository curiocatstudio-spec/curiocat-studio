---
import Layout from '../layouts/Layout.astro';

const values = [
  {
    title: 'Start Simple',
    body: 'Every unforgettable game begins with a simple idea. We believe creativity comes from refining great concepts, not making them unnecessarily complex.',
  },
  {
    title: 'Curiosity Leads',
    body: 'Inspired by the curiosity of a cat, we explore ideas, experiment boldly, and embrace discovery throughout every stage of development.',
  },
  {
    title: 'Craft With Purpose',
    body: 'Every model, mechanic, animation, and line of code exists for a reason. Quality comes from thoughtful decisions and careful execution.',
  },
];

const disciplines = [
  'Environment Art',
  'Hard Surface Modeling',
  'Character Modeling & Animation',
  'Texturing (Substance 3D Painter)',
  'Gameplay Programming (Unity)',
  'Narrative & Level Design',
];

const team = [
  {
    name: 'Muhammad Rafli Zidan Akbari',
    role: 'Game Designer',
    image: '/images/team-1.jpg',
  },
  {
    name: 'Riza Afif Dhafa Thaifuri',
    role: 'Illustrator',
    image: '/images/WMArtboard 1.jpeg',
  },
  {
    name: 'Nasya Azalia',
    role: 'Administration',
    image: '/images/team-3.jpg',
  },
];
---

<Layout
  title="About"
  description="CurioCat Studio is an independent game development studio based in Surabaya, Indonesia. Learn about our values, our craft, and the way we build games."
>
  <!-- ABOUT HERO -->
  <section
    class="relative pt-36 md:pt-40 pb-20 px-6 border-b border-charcoal-border overflow-hidden"
  >
    <div class="grid-backdrop"></div>

    <div class="relative max-w-6xl mx-auto" data-reveal="fade">
      <div class="max-w-4xl">
        <p class="eyebrow mb-4">
          About the Studio
        </p>

        <h1
          class="font-display text-4xl md:text-6xl uppercase tracking-tightest font-semibold text-bone leading-tight"
        >
          Turning
          <span class="text-gold">Simple Ideas</span>
          <br class="hidden md:block" />
          Into Unforgettable Games
        </h1>

        <p class="mt-7 text-lg text-muted leading-relaxed max-w-2xl">
          CurioCat Studio is an independent game development studio based in
          Surabaya, Indonesia.
        </p>

        <p class="mt-4 text-muted leading-relaxed max-w-2xl">
          Inspired by curiosity, we believe every unforgettable game begins
          with a simple idea.
        </p>

        <p class="mt-4 text-muted leading-relaxed max-w-2xl">
          Our mission is to transform simple ideas into unforgettable games
          that spark curiosity, inspire imagination, and leave players with
          meaningful experiences.
        </p>

        <p class="mt-4 text-muted leading-relaxed max-w-2xl">
          From the first sketch to the final build, every project is crafted
          with creativity, care, and attention to detail.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section
    class="py-20 md:py-24 px-6 border-b border-charcoal-border grain-panel"
  >
    <div class="max-w-6xl mx-auto">
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-center"
      >
        <div data-reveal="left">
          <img
            src="/images/logo.png"
            alt="CurioCat Studio"
            class="w-full max-w-xl border border-charcoal-border"
          />
        </div>

        <div class="max-w-xl" data-reveal="right">
          <p class="eyebrow mb-4">
            How We Work
          </p>

          <h2
            class="font-display text-3xl md:text-4xl uppercase tracking-tightest font-semibold text-bone leading-tight mb-6"
          >
            From Simple Ideas
            <br />
            To Meaningful Experiences
          </h2>

          <p class="text-bone/90 leading-relaxed mb-5">
            Every project starts with a simple idea. Instead of chasing trends
            or unnecessary complexity, we focus on refining concepts until
            they become memorable gameplay experiences.
          </p>

          <p class="text-muted leading-relaxed">
            From concept, game design, programming, and 3D art to the final
            polish, every part of development is driven by curiosity,
            craftsmanship, and a passion for creating games people will
            remember.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR VALUES -->
  <section
    class="py-24 md:py-28 px-6 border-b border-charcoal-border"
  >
    <div class="max-w-6xl mx-auto">
      <div class="max-w-3xl mb-14" data-reveal="fade">
        <p class="eyebrow mb-3">
          What We Believe
        </p>

        <h2
          class="font-display text-3xl md:text-5xl uppercase tracking-tightest font-semibold text-bone leading-tight"
        >
          Our Values
        </h2>

        <p class="text-muted leading-relaxed mt-5 max-w-2xl">
          The principles that guide how we think, create, and build every
          project at CurioCat Studio.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {values.map((value, i) => (
          <div
            class="p-7 md:p-8 border border-charcoal-border panel"
            data-reveal="scale"
            style={`--delay:${i * 100}ms`}
          >
            <h3 class="font-display text-xl md:text-2xl text-gold mb-4">
              {value.title}
            </h3>

            <p class="text-sm text-muted leading-relaxed">
              {value.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR CRAFT -->
  <section
    class="py-24 md:py-28 px-6 border-b border-charcoal-border"
  >
    <div class="max-w-6xl mx-auto">
      <div class="max-w-3xl mb-12" data-reveal="fade">
        <p class="eyebrow mb-3">
          What We Do
        </p>

        <h2
          class="font-display text-3xl md:text-5xl uppercase tracking-tightest font-semibold text-bone leading-tight"
        >
          Our Craft
        </h2>

        <p class="text-muted leading-relaxed mt-5 max-w-2xl">
          A multidisciplinary approach combining art, technology, design, and
          storytelling to create complete interactive experiences.
        </p>
      </div>

      <div class="flex flex-wrap gap-3" data-reveal="fade">
        {disciplines.map((discipline) => (
          <span
            class="curio-plate px-4 py-2 border border-charcoal-border text-bone/70"
          >
            {discipline}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- MEET THE DEVELOPER -->
  <section
    class="py-24 md:py-28 px-6 border-b border-charcoal-border"
  >
    <div class="max-w-6xl mx-auto">
      <div
        class="grid grid-cols-1 md:grid-cols-[240px_1fr] lg:grid-cols-[280px_1fr] gap-10 lg:gap-16 items-start"
        data-reveal="fade"
      >
        <div>
          <img
            src="/images/syauqi.jpeg"
            alt="Muhammad Syauqi Akifur Rahman"
            class="w-48 h-48 md:w-56 md:h-56 lg:w-64 lg:h-64 rounded-full object-cover border border-charcoal-border"
          />
        </div>

        <div class="max-w-3xl">
          <p class="eyebrow mb-3">
            Behind CurioCat Studio
          </p>

          <h2
            class="font-display text-3xl md:text-4xl text-bone leading-tight"
          >
            Muhammad Syauqi Akifur Rahman
          </h2>

          <p class="text-gold mt-3">
            Founder / Game Developer / 3D Artist
          </p>

          <div class="mt-7 space-y-4 text-muted leading-8">
            <p>
              I'm the founder of CurioCat Studio, where I lead a small team of
              passionate creators dedicated to developing meaningful
              interactive experiences.
            </p>

            <p>
              Together, we bring different skills and perspectives into every
              stage of development, from the initial concept to the final
              polish.
            </p>

            <p>
              CurioCat Studio was built on a simple belief: great games don't
              have to begin with complicated ideas. Through curiosity,
              creativity, and collaboration, we strive to transform simple
              concepts into memorable games that stay with players long after
              they finish playing.
            </p>
          </div>

          <div class="flex flex-wrap gap-3 mt-8">
            <span class="curio-plate">Blender</span>
            <span class="curio-plate">Unity</span>
            <span class="curio-plate">C#</span>
            <span class="curio-plate">Game Design</span>
            <span class="curio-plate">3D Environment</span>
            <span class="curio-plate">Lighting</span>
          </div>

          <div class="flex flex-wrap gap-6 mt-8">
            <a
              href="https://www.linkedin.com/in/muhammad-syauqi-akifur-rahman-ba2670353/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted hover:text-gold transition"
            >
              LinkedIn
            </a>

            <a
              href="https://www.instagram.com/aakifurr_/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted hover:text-gold transition"
            >
              Instagram
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR TEAM -->
  <section class="py-24 md:py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-3xl mb-14" data-reveal="fade">
        <p class="eyebrow mb-3">
          The People Behind The Games
        </p>

        <h2
          class="font-display text-3xl md:text-5xl uppercase tracking-tightest font-semibold text-bone leading-tight"
        >
          Our Team
        </h2>

        <p class="text-muted max-w-2xl mt-5 leading-relaxed">
          A small team driven by curiosity, creativity, and a passion for
          creating memorable interactive experiences.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
      >
        {team.map((member, i) => (
          <div
            class="group border border-charcoal-border panel p-5"
            data-reveal="scale"
            style={`--delay:${i * 100}ms`}
          >
            <div
              class="aspect-square overflow-hidden border border-charcoal-border mb-5"
            >
              <img
                src={member.image}
                alt={member.name}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>

            <div>
              <h3
                class="font-display text-lg md:text-xl text-bone leading-snug"
              >
                {member.name}
              </h3>

              <p class="text-sm text-gold mt-2">
                {member.role}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>