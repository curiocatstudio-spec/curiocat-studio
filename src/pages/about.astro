---
import Layout from '../layouts/Layout.astro';

const values = [
  {
    title: 'Start Simple',
    body: 'Every unforgettable game begins with a simple idea. We believe creativity comes from refining great concepts, not making them unnecessarily complex.',
  },
  {
    title: 'Curiosity Leads',
    body: 'Inspired by the curiosity of a cat, we explore ideas, experiment boldly, and embrace discovery throughout every stage of development.',
  },
  {
    title: 'Craft With Purpose',
    body: 'Every model, mechanic, animation, and line of code exists for a reason. Quality comes from thoughtful decisions and careful execution.',
  },
];

const disciplines = [
  'Environment Art',
  'Hard Surface Modeling',
  'Character Modeling & Animation',
  'Texturing (Substance 3D Painter)',
  'Gameplay Programming (Unity)',
  'Narrative & Level Design',
];

const team = [
  {
    name: 'Muhammad Rafli Zidan Akbari',
    role: 'Game Designer',
    image: '/images/team-1.jpg',
  },
  {
    name: 'Riza Afif Dhafa Thaifuri',
    role: 'Illustrator',
    image: '/images/WMArtboard 1.jpeg',
  },
  {
    name: 'Nasya Azalia',
    role: 'Administration',
    image: '/images/team-3.jpg',
  },
  {
    name: 'Sofwan Ali',
    role: '3D Artist',
    image: '/images/team-3.jpg',
  },
];
---

<Layout
  title="About"
  description="CurioCat Studio is an independent game development studio based in Surabaya, Indonesia. Learn about our values, our craft, and the way we build games."
>
  <!-- ========================================= -->
  <!-- HERO -->
  <!-- ========================================= -->

  <section class="relative overflow-hidden border-b border-charcoal-border">
    <div class="grid-backdrop absolute inset-0"></div>

    <div class="relative mx-auto max-w-6xl px-6 pb-24 pt-36 md:pb-28 md:pt-44">
      <div class="max-w-4xl" data-reveal="fade">
        <p class="eyebrow mb-5">
          About the Studio
        </p>

        <h1
          class="font-display text-4xl font-semibold uppercase leading-[1.05] tracking-tightest text-bone sm:text-5xl md:text-6xl lg:text-7xl"
        >
          Turning
          <span class="text-gold">Simple Ideas</span>
          <br class="hidden md:block" />
          Into Unforgettable Games
        </h1>

        <div class="mt-8 max-w-2xl space-y-4">
          <p class="text-lg leading-relaxed text-bone/90">
            CurioCat Studio is an independent game development studio based in
            Surabaya, Indonesia.
          </p>

          <p class="leading-relaxed text-muted">
            Inspired by curiosity, we believe every unforgettable game begins
            with a simple idea.
          </p>

          <p class="leading-relaxed text-muted">
            Our mission is to transform simple ideas into unforgettable games
            that spark curiosity, inspire imagination, and leave players with
            meaningful experiences.
          </p>

          <p class="leading-relaxed text-muted">
            From the first sketch to the final build, every project is crafted
            with creativity, care, and attention to detail.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ========================================= -->
  <!-- HOW WE WORK -->
  <!-- ========================================= -->

  <section class="border-b border-charcoal-border">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <div
        class="grid items-center gap-12 md:grid-cols-[0.9fr_1.1fr] lg:gap-20"
      >
        <!-- Logo -->
        <div data-reveal="left">
          <div
            class="flex aspect-square items-center justify-center border border-charcoal-border bg-black/10 p-8 md:p-12"
          >
            <img
              src="/images/logo.png"
              alt="CurioCat Studio"
              class="w-full max-w-md object-contain"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Content -->
        <div class="max-w-xl" data-reveal="right">
          <p class="eyebrow mb-4">
            How We Work
          </p>

          <h2
            class="font-display text-3xl font-semibold uppercase leading-[1.1] tracking-tightest text-bone md:text-4xl lg:text-5xl"
          >
            From Simple Ideas
            <br />
            <span class="text-gold">To Meaningful Experiences</span>
          </h2>

          <div class="mt-7 space-y-5">
            <p class="leading-relaxed text-bone/90">
              Every project starts with a simple idea. Instead of chasing trends
              or unnecessary complexity, we focus on refining concepts until
              they become memorable gameplay experiences.
            </p>

            <p class="leading-relaxed text-muted">
              From concept, game design, programming, and 3D art to the final
              polish, every part of development is driven by curiosity,
              craftsmanship, and a passion for creating games people will
              remember.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ========================================= -->
  <!-- OUR VALUES -->
  <!-- ========================================= -->

  <section class="border-b border-charcoal-border">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <!-- Heading -->
      <div class="mb-12 max-w-3xl md:mb-14" data-reveal="fade">
        <p class="eyebrow mb-4">
          What We Believe
        </p>

        <h2
          class="font-display text-3xl font-semibold uppercase leading-tight tracking-tightest text-bone md:text-5xl"
        >
          Our Values
        </h2>

        <p class="mt-5 max-w-2xl leading-relaxed text-muted">
          The principles that guide how we think, create, and build every
          project at CurioCat Studio.
        </p>
      </div>

      <!-- Cards -->
      <div class="grid gap-5 md:grid-cols-3 md:gap-6">
        {
          values.map((value, i) => (
            <article
              class="panel group relative overflow-hidden border border-charcoal-border p-6 md:p-8"
              data-reveal="scale"
              style={`--delay:${i * 100}ms`}
            >
              <div
                class="absolute left-0 top-0 h-px w-0 bg-gold transition-all duration-500 group-hover:w-full"
              ></div>

              <span class="mb-7 block font-display text-xs tracking-[0.2em] text-muted">
                0{i + 1}
              </span>

              <h3 class="font-display text-xl text-gold md:text-2xl">
                {value.title}
              </h3>

              <p class="mt-4 text-sm leading-7 text-muted">
                {value.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>


  <!-- ========================================= -->
  <!-- OUR CRAFT -->
  <!-- ========================================= -->

  <section class="border-b border-charcoal-border grain-panel">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <div
        class="grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-start lg:gap-20"
      >
        <!-- Heading -->
        <div data-reveal="left">
          <p class="eyebrow mb-4">
            What We Do
          </p>

          <h2
            class="font-display text-3xl font-semibold uppercase leading-tight tracking-tightest text-bone md:text-5xl"
          >
            Our Craft
          </h2>

          <p class="mt-5 max-w-md leading-relaxed text-muted">
            A multidisciplinary approach combining art, technology, design, and
            storytelling to create complete interactive experiences.
          </p>
        </div>

        <!-- Disciplines -->
        <div data-reveal="right">
          <div class="grid gap-3 sm:grid-cols-2">
            {
              disciplines.map((discipline, i) => (
                <div
                  class="group flex min-h-16 items-center border border-charcoal-border px-5 py-4 transition-colors duration-300 hover:border-gold/50"
                  style={`--delay:${i * 70}ms`}
                >
                  <span class="mr-4 font-display text-xs text-gold/60">
                    0{i + 1}
                  </span>

                  <span class="text-sm leading-snug text-bone/75 transition-colors group-hover:text-bone">
                    {discipline}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ========================================= -->
  <!-- FOUNDER -->
  <!-- ========================================= -->

  <section class="border-b border-charcoal-border">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <div
        class="grid gap-10 md:grid-cols-[220px_1fr] lg:grid-cols-[280px_1fr] lg:gap-16"
        data-reveal="fade"
      >
        <!-- Portrait -->
        <div>
          <div class="relative mx-auto w-full max-w-[280px] md:mx-0">
            <div
              class="absolute -inset-2 border border-charcoal-border opacity-60"
            ></div>

            <img
              src="/images/syauqi.jpeg"
              alt="Muhammad Syauqi Akifur Rahman"
              class="relative aspect-square w-full rounded-full border border-charcoal-border object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Founder content -->
        <div class="max-w-3xl">
          <p class="eyebrow mb-4">
            Behind CurioCat Studio
          </p>

          <h2
            class="font-display text-3xl leading-tight tracking-tight text-bone md:text-4xl lg:text-5xl"
          >
            Muhammad Syauqi Akifur Rahman
          </h2>

          <p class="mt-3 text-sm uppercase tracking-[0.15em] text-gold">
            Founder / Game Developer / 3D Artist
          </p>

          <div class="mt-7 space-y-5 leading-8 text-muted">
            <p>
              I'm the founder of CurioCat Studio, where I lead a small team of
              passionate creators dedicated to developing meaningful
              interactive experiences.
            </p>

            <p>
              Together, we bring different skills and perspectives into every
              stage of development, from the initial concept to the final
              polish.
            </p>

            <p>
              CurioCat Studio was built on a simple belief: great games don't
              have to begin with complicated ideas. Through curiosity,
              creativity, and collaboration, we strive to transform simple
              concepts into memorable games that stay with players long after
              they finish playing.
            </p>
          </div>

          <!-- Skills -->
          <div class="mt-8 flex flex-wrap gap-2">
            <span class="curio-plate">Blender</span>
            <span class="curio-plate">Unity</span>
            <span class="curio-plate">C#</span>
            <span class="curio-plate">Game Design</span>
            <span class="curio-plate">3D Environment</span>
            <span class="curio-plate">Lighting</span>
          </div>

          <!-- Socials -->
          <div class="mt-8 flex flex-wrap gap-x-7 gap-y-3">
            <a
              href="https://www.linkedin.com/in/muhammad-syauqi-akifur-rahman-ba2670353/"
              target="_blank"
              rel="noopener noreferrer"
              class="group text-sm text-muted transition-colors hover:text-gold"
            >
              LinkedIn
              <span
                class="ml-1 inline-block transition-transform duration-300 group-hover:translate-x-1"
              >
                ↗
              </span>
            </a>

            <a
              href="https://www.instagram.com/aakifurr_/"
              target="_blank"
              rel="noopener noreferrer"
              class="group text-sm text-muted transition-colors hover:text-gold"
            >
              Instagram
              <span
                class="ml-1 inline-block transition-transform duration-300 group-hover:translate-x-1"
              >
                ↗
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ========================================= -->
  <!-- TEAM -->
  <!-- ========================================= -->

  <section>
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <!-- Heading -->
      <div class="mb-12 max-w-3xl md:mb-14" data-reveal="fade">
        <p class="eyebrow mb-4">
          The People Behind The Games
        </p>

        <h2
          class="font-display text-3xl font-semibold uppercase leading-tight tracking-tightest text-bone md:text-5xl"
        >
          Our Team
        </h2>

        <p class="mt-5 max-w-2xl leading-relaxed text-muted">
          A small team driven by curiosity, creativity, and a passion for
          creating memorable interactive experiences.
        </p>
      </div>

      <!-- Team cards -->
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
        {
          team.map((member, i) => (
            <article
              class="group border border-charcoal-border panel p-4 md:p-5"
              data-reveal="scale"
              style={`--delay:${i * 100}ms`}
            >
              <div class="relative aspect-square overflow-hidden border border-charcoal-border">
                <img
                  src={member.image}
                  alt={member.name}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />

                <div
                  class="pointer-events-none absolute inset-0 border border-transparent transition-colors duration-500 group-hover:border-gold/30"
                ></div>
              </div>

              <div class="px-1 pb-1 pt-5">
                <h3
                  class="font-display text-lg leading-snug text-bone md:text-xl"
                >
                  {member.name}
                </h3>

                <p class="mt-2 text-xs uppercase tracking-[0.15em] text-gold">
                  {member.role}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
```
