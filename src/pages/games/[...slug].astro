---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const { Content } = await render(game);


const statusLabel: Record<string, string> = {
  released: 'Released',
  'in-development': 'In Development',
  concept: 'Concept',
};

const accentClass = game.data.accent === 'crimson' ? 'text-crimson-bright' : 'text-gold';
---

<script>
document.addEventListener("DOMContentLoaded", () => {

  const track = document.querySelector(".gallery-track");
  const prev = document.querySelector(".gallery-btn.prev");
  const next = document.querySelector(".gallery-btn.next");

  if (!track) return;

  const slideWidth = () => {
    const slide = track.querySelector(".gallery-slide");
    return slide ? slide.clientWidth + 24 : 0;
  };

  prev?.addEventListener("click", () => {
    track.scrollBy({
      left: -slideWidth(),
      behavior: "smooth"
    });
  });

  next?.addEventListener("click", () => {
    track.scrollBy({
      left: slideWidth(),
      behavior: "smooth"
    });
  });

  // ===== Drag Mouse =====
  let isDown = false;
  let startX;
  let scrollLeft;

  track.addEventListener("mousedown", (e) => {
    isDown = true;
    track.classList.add("dragging");

    startX = e.pageX - track.offsetLeft;
    scrollLeft = track.scrollLeft;
  });

  track.addEventListener("mouseleave", () => {
    isDown = false;
    track.classList.remove("dragging");
  });

  track.addEventListener("mouseup", () => {
    isDown = false;
    track.classList.remove("dragging");
  });

  track.addEventListener("mousemove", (e) => {
    if (!isDown) return;

    e.preventDefault();

    const x = e.pageX - track.offsetLeft;
    const walk = (x - startX) * 1.8;

    track.scrollLeft = scrollLeft - walk;
  });

});
</script>

<Layout title={game.data.title} description={game.data.tagline}>
<div
  class="game-background"
  style={`background-image:url(${game.data.banner});`}
></div>
<section class="relative w-full aspect-[16/9] overflow-hidden">

  <img
    src={game.data.banner}
    alt={game.data.title}
    class="absolute inset-0 w-full h-full object-cover"
  />

  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>

</section>
  <div class="max-w-6xl mx-auto px-6">
  <div class="flex items-stretch gap-10">

  <!-- Logo -->
  <img
    src={game.data.logo}
    alt={`${game.data.title} Logo`}
    class="h-full max-h-80 w-auto object-contain shrink-0"
  />

  <!-- Semua informasi di sebelah kanan -->
  <div class="flex-1">

    <h1 class="display-headline text-5xl md:text-6xl">
      {game.data.title}
    </h1>

    <p class="mt-3 text-gold text-lg">
      {game.data.tagline}
    </p>

    <!-- Platform & Engine -->
    <div class="flex gap-12 mt-8 text-sm">

      <div>
        <p class="curio-plate text-muted mb-1">
          Platform
        </p>

        <p class="text-bone/80">
          {game.data.platform}
        </p>
      </div>

      <div>
        <p class="curio-plate text-muted mb-1">
          Engine
        </p>

        <p class="text-bone/80">
          {game.data.engine}
        </p>
      </div>

    </div>

    <!-- Tombol -->
    <div class="flex flex-wrap gap-4 mt-8">

      {
        game.data.status === "released" ? (

          <a
            href={game.data.itchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 bg-crimson-bright text-white font-semibold uppercase tracking-wider transition-all duration-300 hover:scale-105 hover:shadow-lg"
          >
            Download on itch.io
          </a>

        ) : game.data.status === "in-development" ? (

          <button
            disabled
            class="inline-flex items-center justify-center px-8 py-4 bg-zinc-700 text-zinc-300 font-semibold uppercase tracking-wider opacity-70 cursor-not-allowed"
          >
            Coming Soon
          </button>

        ) : (

          <button
            disabled
            class="inline-flex items-center justify-center px-8 py-4 bg-zinc-800 text-zinc-400 font-semibold uppercase tracking-wider opacity-60 cursor-not-allowed"
          >
            Concept
          </button>

        )
      }

      <a
        href="#trailer"
        class="inline-flex items-center justify-center px-8 py-4 border border-charcoal-border bg-charcoal text-bone font-semibold uppercase tracking-wider transition-all duration-300 hover:bg-charcoal-border"
      >
        ▶ Watch Trailer
      </a>

    </div>

  </div>

</div>
  <!-- TRAILER -->
  <section id="trailer" class="py-16 px-6 border-b border-charcoal-border">
    <div class="max-w-4xl mx-auto" data-reveal="scale">
      <p class="eyebrow mb-4">Trailer</p>
      <div class="relative aspect-video overflow-hidden border border-charcoal-border bg-charcoal grain-panel">
        {
  game.data.trailer ? (
    <iframe
  class="w-full h-full rounded-lg"
  src={`https://www.youtube.com/embed/${game.data.trailer.youtube}`}
  title={`${game.data.title} Trailer`}
  referrerpolicy="strict-origin-when-cross-origin"
  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
  allowfullscreen
></iframe>
  ) : (
    <div class="w-full h-full flex flex-col items-center justify-center gap-3">
      <img
        src={game.data.cover}
        alt={`${game.data.title} placeholder`}
        class="absolute inset-0 w-full h-full object-cover opacity-30"
      />
      <div class="relative z-10 flex flex-col items-center gap-3 text-center px-6">
        <svg width="52" height="52" viewBox="0 0 24 24" fill="none" class="text-gold">
          <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.4" />
          <path d="M10 8.5L16 12L10 15.5V8.5Z" fill="currentColor" />
        </svg>

        <p class="curio-plate text-muted">
          Trailer coming soon
        </p>
      </div>
    </div>
  )
}
      </div>
    </div>
  </section>

  <!-- SCREENSHOT GALLERY -->
  {game.data.gallery.length > 0 && (
<section class="py-16 px-6 border-b border-charcoal-border">

  <div class="max-w-6xl mx-auto">

    <p class="eyebrow mb-8 text-center">
      Gallery
    </p>

    <div class="gallery-slider">

      <button class="gallery-btn prev">
        &#10094;
      </button>

      <div class="gallery-track">

        {game.data.gallery.map((shot: string, i: number) => (

          <div class="gallery-slide">

            <img
              src={shot}
              alt={`${game.data.title} Screenshot ${i + 1}`}
            />

          </div>

        ))}

      </div>

      <button class="gallery-btn next">
        &#10095;
      </button>

    </div>

    <div class="gallery-dots"></div>

  </div>

</section>
)}

  <!-- CONTENT -->
<section class="story-section py-16 px-6">
  <article
    class="max-w-2xl mx-auto prose-cc relative z-10"
    data-reveal="fade"
  >
    <Content />
  </article>
</section>

  

  <!-- DEVELOPED BY -->
<section class="py-20 px-6 border-t border-charcoal-border">
  <div
    class="max-w-3xl mx-auto text-center"
    data-reveal="fade"
  >

    <!-- Logo -->
    <img
      src="/images/logo.png"
      alt="CurioCat Studio"
      class="w-20 h-20 mx-auto mb-6"
    />

    <!-- Heading -->
    <p class="eyebrow mb-3">
      Developed by
    </p>

    <h2 class="font-display text-4xl uppercase tracking-tightest font-semibold text-bone">
      CurioCat Studio
    </h2>

    

    <!-- Founder -->
    <p class="mt-4 text-bone/70">
      Founded by
      <span class="text-bone font-medium">
        Muhammad Syauqi Akifur Rahman
      </span>
    </p>

    <!-- Button -->
    <a
      href="/about"
      class="inline-flex items-center gap-2 mt-10 px-6 py-3 border border-charcoal-border hover:border-gold hover:text-gold transition-all duration-300"
    >
      Learn More About the Studio
      <span>→</span>
    </a>

  </div>
</section>
</Layout>

<style is:global>
  .prose-cc h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.5rem;
    color: #F2F0EA;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose-cc p {
    color: #8C8A85;
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .prose-cc strong {
    color: #F2F0EA;
  }
  .prose-cc ul {
    margin: 1.25rem 0;
    padding-left: 1.25rem;
  }
  .prose-cc li {
    color: #8C8A85;
    line-height: 1.8;
    margin-bottom: 0.5rem;
    list-style: none;
    position: relative;
    padding-left: 1.25rem;
  }
  .prose-cc li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 6px;
    background: #C9A15A;
    border-radius: 999px;
  }
  .prose-cc em {
    color: #9C978C;
  }
</style>
