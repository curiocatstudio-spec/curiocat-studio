---

import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (d: Date) =>
d.toLocaleDateString('en-US', {
year: 'numeric',
month: 'long',
day: 'numeric',
});
---

<Layout
title="Dev Blog"
description="Development logs, design notes, and behind-the-scenes stories from CurioCat Studio."

>

  <!-- HEADER -->

  <section class="relative pt-40 pb-16 px-6 border-b border-charcoal-border">
    <div
      class="max-w-6xl mx-auto"
      data-reveal="fade"
    >
      <p class="eyebrow mb-4">
        Notes From the Studio
      </p>

  <h1
    class="font-display text-4xl md:text-6xl uppercase tracking-tightest font-semibold text-bone"
  >
    Dev Blog
  </h1>

  <p class="mt-6 text-muted max-w-2xl leading-relaxed">
    Design decisions, production diaries, and everything in between —
    written as we build.
  </p>
</div>


  </section>

  <!-- BLOG POSTS -->

  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto">


  <div class="space-y-8">

    {posts.map((post, i) => (

      <a
        href={`/blog/${post.slug}`}
        class="
          group
          grid
          grid-cols-1
          md:grid-cols-[280px_1fr]
          lg:grid-cols-[320px_1fr]
          gap-8
          p-6
          md:p-7
          border
          border-charcoal-border
          bg-charcoal/40
          hover:border-gold/40
          hover:bg-charcoal/60
          transition-all
          duration-300
        "
        data-reveal="fade"
        style={`--delay:${i * 90}ms`}
      >

        <!-- COVER -->
        {post.data.cover && (
          <div
            class="
              aspect-video
              md:aspect-square
              overflow-hidden
              bg-charcoal
            "
          >
            <img
              src={post.data.cover}
              alt={post.data.title}
              class="
                w-full
                h-full
                object-cover
                transition-transform
                duration-700
                group-hover:scale-105
              "
              loading="lazy"
            />
          </div>
        )}


        <!-- CONTENT -->
        <div class="flex flex-col justify-center min-w-0">

          <!-- META -->
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4">

            <span class="curio-plate text-gold">
              {post.data.tag}
            </span>

            <span class="text-muted text-xs uppercase tracking-wide">
              {formatDate(post.data.date)}
            </span>

          </div>


          <!-- TITLE -->
          <h2
            class="
              font-display
              text-2xl
              md:text-3xl
              text-bone
              group-hover:text-gold
              transition-colors
              duration-300
              mb-4
            "
          >
            {post.data.title}
          </h2>


          <!-- EXCERPT -->
          <p
            class="
              text-sm
              md:text-base
              text-muted
              leading-relaxed
              max-w-2xl
              line-clamp-3
            "
          >
            {post.data.excerpt}
          </p>


          <!-- READ MORE -->
          <div
            class="
              mt-6
              flex
              items-center
              gap-3
              text-xs
              uppercase
              tracking-widest
              text-gold
            "
          >
            <span>
              Read Article
            </span>

            <span
              class="
                transition-transform
                duration-300
                group-hover:translate-x-2
              "
            >
              →
            </span>
          </div>

        </div>

      </a>

    ))}

  </div>

</div>


  </section>

</Layout>
