---
import Layout from '../layouts/Layout.astro';
import CatLogoVideo from '../components/CatLogoVideo.astro';
import GameCard from '../components/GameCard.astro';
import { getCollection } from 'astro:content';



const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const featured = games.slice(0, 1);

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);


---

<Layout title="Home">
  <!-- HERO -->
  <section class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden px-6 text-center bg-black">

  <div class="absolute inset-0">
  <div
    id="hero-background"
    class="absolute inset-0 bg-cover bg-center transition-all duration-1000"
    style="background-image: url('/images/hero/hero1.jpeg');">
  </div>

  <div class="absolute inset-0 bg-black/30"></div>
</div>

  <div class="grid-backdrop z-10"></div>

  <CatLogoVideo
  size={820}
  class="relative z-20 mb-6 fade-up"
/>

<div class="scroll-indicator">
  <a href="#games" aria-label="Scroll Down">
    ↓
  </a>
</div>

  <p class="eyebrow fade-up" style="animation-delay: 0.15s">
    Game Studio &mdash; Surabaya, Indonesia
  </p>

  ...

  

</div>

    <h1 class="display-headline fade-up mt-6 text-[2.6rem] sm:text-6xl md:text-7xl lg:text-8xl max-w-5xl text-bone" style="animation-delay: 0.3s">
  Creating <span class="text-gold">Stories</span><br />
  That Stay With You.
</h1>

<p class="fade-up mt-8 text-muted max-w-md leading-relaxed" style="animation-delay: 0.5s">
  CurioCat Studio is an indie game studio dedicated to creating immersive worlds and emotional stories that players will remember long after the credits roll.
</p>


    <div class="fade-up mt-10 flex flex-col sm:flex-row gap-4" style="animation-delay: 0.65s">
      <a href="/games" class="btn-solid">Explore Our Games</a>
      <a href="/about" class="btn-ghost">Our Story</a>
    
</div>
    

  </section>

  

  <!-- DEVELOPMENT JOURNAL -->

<section
class="
relative
py-16
md:py-24
lg:py-28
px-5
sm:px-8
lg:px-12
xl:px-16
border-t
border-charcoal-border
grain-panel
">

  <div class="max-w-7xl mx-auto">



    <div id="journal-slider">

      <button class="journal-arrow prev">
        &#10094;
      </button>

      <div class="journal-track">

        {latestPosts.map((post) => (

          <a
            href={`/blog/${post.slug}`}
            class="journal-slide group"
          >

            <img
              src={post.data.cover}
              alt={post.data.title}
            />

            <div class="journal-overlay">

              <div class="journal-text">

                <h3>
                  {post.data.title}
                </h3>

                <span>
                  Read Story →
                </span>

              </div>

            </div>

          </a>

        ))}

      </div>

      <button class="journal-arrow next">
        &#10095;
      </button>

    </div>

    <div class="journal-dots"></div>

  </div>

  <!-- FEATURED GAMES -->
  <section class="relative py-24 px-6 border-t border-charcoal-border">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-4" data-reveal="fade">
        <div>
          <h2 class="font-display text-3xl md:text-5xl uppercase tracking-tightest font-semibold text-bone">Featured Games</h2>
        </div>
        <a href="/games" class="curio-plate text-bone/70 hover:text-gold transition-colors">View All &rarr;</a>
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {games.map((game, i) => (
        <GameCard
          slug={game.slug}
          title={game.data.title}
          tagline={game.data.tagline}
          genre={game.data.genre}
          status={game.data.status}
          cover={game.data.cover}
          accent={game.data.accent}
          index={i}
        />
      ))}
    </div>
    </div>
  

  <!-- CLOSING STATEMENT -->
  <section class="relative py-32 px-6 border-t border-charcoal-border overflow-hidden">
    <div class="grid-backdrop"></div>
    <div class="relative max-w-3xl mx-auto text-center" data-reveal="scale">
      <p class="font-display text-3xl sm:text-4xl md:text-5xl uppercase tracking-tightest font-semibold text-bone leading-[1.1]">
        Curiosity begins with an idea.
Great games begin with CurioCat. <span class="text-gold">worth experiencing.</span>
      </p>
      <a href="/contact" class="btn-ghost inline-flex mt-10">Let's Talk</a>
    </div>
  </section>


  <script>
const images = [
  "/images/hero/hero1.jpeg",
  "/images/hero/hero2.jpeg",
  "/images/hero/hero3.jpeg",
  "/images/hero/hero4.jpeg",
];

let index = 0;

const hero = document.getElementById("hero-background");

setInterval(() => {
  index = (index + 1) % images.length;

  hero.style.backgroundImage = `url(${images[index]})`;
}, 5000);

/* ===== Development Journal Slider ===== */

const slides = document.querySelectorAll(".journal-slide");

let currentSlide = 0;

// tampilkan slide pertama
slides[currentSlide].classList.add("active");

setInterval(() => {

  slides[currentSlide].classList.remove("active");

  currentSlide++;

  if(currentSlide >= slides.length){
    currentSlide = 0;
  }

  slides[currentSlide].classList.add("active");

},5000);
</script>
</Layout> 
